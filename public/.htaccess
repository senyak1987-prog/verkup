RewriteEngine On
RewriteBase /verkup/
DirectoryIndex index.html

# Only files emitted with a content hash may be cached permanently.
RewriteRule ^assets/.+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$ - [E=GOROD_SVET_IMMUTABLE:1]

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .mjs .json .svg
AddType text/html;charset=UTF-8 .html
AddType text/css;charset=UTF-8 .css
AddType application/javascript;charset=UTF-8 .js .mjs
AddType application/json;charset=UTF-8 .json
AddType image/svg+xml;charset=UTF-8 .svg
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=GOROD_SVET_IMMUTABLE
  # This override follows the immutable policy, including after an HTML fallback.
  <FilesMatch "(\.html$|^sw\.js$)">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /verkup/index.html [L]
